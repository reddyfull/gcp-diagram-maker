<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Rule for handling session URLs -->
        <rule name="Session URL Redirect" stopProcessing="true">
          <match url=".*session_[A-Za-z0-9_-]+.*" />
          <action type="Rewrite" url="/direct-session.html" />
        </rule>
      </rules>
    </rewrite>
    <httpErrors>
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/direct-session.html" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration> 